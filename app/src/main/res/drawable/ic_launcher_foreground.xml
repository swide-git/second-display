<?xml version="1.0" encoding="utf-8"?>
<!-- Second Display: a monitor with a tablet in front of it as its second screen, in the
     Material You tonal palette (Palette.kt). Drawn on the 108 dp adaptive canvas and scaled
     to 92 % around the centre so the corners stay inside the 72 dp visible area. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92">
        <!-- Monitor, cut around the tablet so a background-coloured gap separates them -->
        <path
            android:fillColor="#FF9F43"
            android:pathData="M32,30 H68 A5,5 0 0 1 73,35 V39 H60 A8,8 0 0 0 52,47 V60 H32 A5,5 0 0 1 27,55 V35 A5,5 0 0 1 32,30 Z" />
        <path
            android:fillColor="#FF9F43"
            android:pathData="M38,60 h8 v6 h-8 z M34.5,66 h15 a1.5,1.5 0 0 1 0,3 h-15 a1.5,1.5 0 0 1 0,-3 z" />
        <!-- Tablet with two lines of mirrored content -->
        <path
            android:fillColor="#904D00"
            android:pathData="M60,42 h16 a5,5 0 0 1 5,5 v26 a5,5 0 0 1 -5,5 h-16 a5,5 0 0 1 -5,-5 v-26 a5,5 0 0 1 5,-5 z" />
        <path
            android:fillColor="#FFDCC2"
            android:pathData="M60.5,49 h15 a1.5,1.5 0 0 1 0,3 h-15 a1.5,1.5 0 0 1 0,-3 z M60.5,55 h9 a1.5,1.5 0 0 1 0,3 h-9 a1.5,1.5 0 0 1 0,-3 z" />
    </group>
</vector>
